# Copy to .env to change these. Both are optional.

# Where the API lives. Keep /api when the API serves this app or during npm run dev (Vite proxies it).
VITE_API_URL=/api

# true: no server needed, accounts and edits stay in this browser (used for the shareable preview).
VITE_DEMO_MODE=false

# true: visitors must log in before they can read anything.
VITE_REQUIRE_LOGIN=false
