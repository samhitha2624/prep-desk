{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.exclude": {
    "**/node_modules": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/package-lock.json": true,
    "**/data/db.json": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .prettierrc, .editorconfig, .gitignore",
    ".env.example": ".env, .env.*"
  }
}
