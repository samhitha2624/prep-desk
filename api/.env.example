# Copy to api/.env and adjust. All values are optional for local development.

# Port the API listens on. The web dev server forwards /api here.
PORT=4000

# Secret used to sign login cookies. Set a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a secret is generated and kept in data/.secret.
AUTH_SECRET=

# Emails that are always admins, comma separated. The first account ever created is also an admin.
ADMIN_EMAILS=

# Where the database file lives (created on first run from data/seed).
DATA_FILE=data/db.json

# Allowed browser origin when the web app is hosted on a different domain, e.g. https://prepdesk.example.com
CORS_ORIGIN=

# production makes login cookies Secure (HTTPS only) and requires AUTH_SECRET.
NODE_ENV=development
